{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HistoryPlatformQuestion",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "type", "period", "question", "answer", "explanation", "difficulty", "tags"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "type": {
        "type": "string",
        "enum": ["true_false"]
      },
      "period": {
        "type": "string"
      },
      "question": {
        "type": "string",
        "minLength": 12
      },
      "answer": {
        "type": "boolean"
      },
      "explanation": {
        "type": "string",
        "minLength": 20
      },
      "difficulty": {
        "type": "string",
        "enum": ["easy", "medium", "hard"]
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    }
  }
}
