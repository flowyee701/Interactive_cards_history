{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HistoryPlatformQuestion",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "type", "period", "question", "answer", "explanation", "difficulty", "tags"],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$"
      },
      "type": {
        "type": "string",
        "enum": ["true_false", "multiple_choice"]
      },
      "period": {
        "type": "string"
      },
      "question": {
        "type": "string",
        "minLength": 12
      },
      "answer": {
        "oneOf": [
          {
            "type": "boolean"
          },
          {
            "type": "string"
          }
        ]
      },
      "explanation": {
        "type": "string",
        "minLength": 20
      },
      "difficulty": {
        "type": "string",
        "enum": ["easy", "medium", "hard"]
      },
      "tags": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      },
      "options": {
        "type": "array",
        "minItems": 2,
        "items": {
          "type": "object",
          "required": ["id", "label"],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "label": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "source": {
        "type": "object",
        "required": ["title", "url"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 3
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    }
  }
}
